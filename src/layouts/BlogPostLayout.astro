---
import BaseLayout from './BaseLayout.astro';
import '../styles/blog.css';

interface Props {
  title: string;
  date: Date;
  thumbnail: string;
}

const { title, date, thumbnail } = Astro.props;
---

<BaseLayout title={`${title} | Mike Gilmore`} description={`Technical article by Mike Gilmore: ${title}`}>
  <article class="blog-post shell">
    <a class="text-link blog-back" href="/blog/">← All writing</a>
    <header class="blog-post__header">
      <p class="eyebrow">Technical writing</p>
      <h1>{title}</h1>
      <p class="post-date">{date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
    </header>
    <img src={thumbnail} alt="" class="blog-thumbnail" />
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
