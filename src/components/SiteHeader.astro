---
interface Props {
  activeHref?: string;
}

const { activeHref } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/work/', label: 'Work' },
  { href: '/blog/', label: 'Writing' },
  { href: '/about/', label: 'About' },
  { href: '/resume/', label: 'Resume' },
];

const currentHref = activeHref ?? (
  path === '/'
    ? '/'
    : nav.find(({ href }) => href !== '/' && path.startsWith(href))?.href
);

const currentType = currentHref
  ? path === currentHref
    ? 'page'
    : 'location'
  : undefined;
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a class="brand" href="/" aria-label="Mike Gilmore home">
      <span class="brand__mark" aria-hidden="true">MG</span>
      <span class="brand__name">Mike Gilmore</span>
    </a>
    <nav aria-label="Primary navigation">
      <ul class="nav-list">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={currentHref === item.href ? currentType : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
