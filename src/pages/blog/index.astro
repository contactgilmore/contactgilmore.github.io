---
import { getCollection } from 'astro:content';
import { getBlogPath } from '../../lib/blog-paths';
import { compareBlogPosts } from '../../lib/blog-sort';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/blog.css';

const posts = (await getCollection('blog'))
  .filter(({ data }) => data.draft !== true)
  .sort(compareBlogPosts);

const formatShortDate = (value: Date) => value.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout
  title="Writing | Mike Gilmore"
  description="Technical writing by Mike Gilmore on reliability, infrastructure, automation, observability, AI-assisted engineering, and the tools behind the work."
>
  <header class="page-hero shell">
    <p class="eyebrow">Writing</p>
    <h1>Technical ideas, made practical.</h1>
    <p>
      Notes and explainers on reliability, infrastructure, automation, observability, AI-assisted engineering, and the tools behind modern technical work.
      I use this space to make unfamiliar systems easier to understand, connect the tools to real operating problems, and document what changes as the technology evolves.
    </p>
  </header>

  <section class="shell writing-list" aria-label="Article archive">
    {posts.map((post) => {
      const isSeriesIntro = post.data.seriesOrder === 0;
      return (
        <article class:list={['writing-row', { 'writing-row--series-intro': isSeriesIntro }]}>
          <div>
            <p class="writing-row__date">
              {formatShortDate(post.data.date)}
              {post.data.updated && <> · Updated {formatShortDate(post.data.updated)}</>}
            </p>
            <h2><a href={getBlogPath(post.id, post.data.slug)}>{post.data.title}</a></h2>
          </div>
          <p class="writing-row__meta">
            {isSeriesIntro && <span class="writing-row__intro-label">Series introduction</span>}
            <span>{post.data.series || post.data.categories?.slice(0, 3).join(' · ') || 'Technical writing'}</span>
          </p>
        </article>
      );
    })}
  </section>
</BaseLayout>