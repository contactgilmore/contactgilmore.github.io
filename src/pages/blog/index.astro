---
import { getCollection } from 'astro:content';
import { getLegacyBlogPath } from '../../lib/blog-paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/blog.css';

const posts = (await getCollection('blog'))
  .filter(({ data }) => data.draft !== true)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Writing | Mike Gilmore"
  description="Technical writing by Mike Gilmore on reliability, infrastructure, automation, observability, AI-assisted engineering, and the tools behind the work."
>
  <header class="page-hero shell">
    <p class="eyebrow">Writing</p>
    <h1>Technical ideas, made practical.</h1>
    <p>
      Notes and explainers on reliability, infrastructure, automation, observability, AI-assisted engineering, and the tools behind modern technical work.
      I use this space to make unfamiliar systems easier to understand, connect the tools to real operating problems, and document what changes as the technology evolves.
    </p>
  </header>

  <section class="shell writing-list" aria-label="Article archive">
    {posts.map((post) => (
      <article class="writing-row">
        <div>
          <p class="writing-row__date">
            {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            {post.data.updated && <> · Updated {post.data.updated.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</>}
          </p>
          <h2><a href={getLegacyBlogPath(post.id)}>{post.data.title}</a></h2>
        </div>
        <p>{post.data.series || post.data.categories?.slice(0, 3).join(' · ') || 'Technical writing'}</p>
      </article>
    ))}
  </section>
</BaseLayout>
