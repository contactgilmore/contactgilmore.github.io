---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLegacyBlogPath } from '../lib/blog-paths';

const featuredPosts = (await getCollection('blog'))
  .filter(({ data }) => data.draft !== true)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatShortDate = (value: Date) => value.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});

const pillars = [
  {
    title: 'Implementation & Technical Delivery',
    body: 'Translate discovery and requirements into practical onboarding, migration, deployment, readiness, and adoption plans for customer-facing SaaS environments.',
  },
  {
    title: 'Integrations & Troubleshooting',
    body: 'Work across APIs, authentication, SQL, cloud infrastructure, observability, and production systems to isolate problems and turn technical evidence into a next action.',
  },
  {
    title: 'Customer & Stakeholder Leadership',
    body: 'Build alignment across customers, partners, Product, Engineering, and operations through clear discovery, evidence, ownership, documentation, and follow-through.',
  },
];

const selectedWork = [
  {
    eyebrow: 'Enterprise delivery',
    title: 'From a difficult first migration to a repeatable delivery system',
    metric: '100+',
    metricLabel: 'enterprise migrations, implementations, and deployments supported',
    body: 'Turned lessons from complex customer migrations into scripts, validation checks, runbooks, and repeatable workflows.',
    href: '/work/implementation-delivery/',
  },
  {
    eyebrow: 'SaaS reliability',
    title: 'From customer outage complaints to permanent remediation',
    metric: '55%',
    metricLabel: 'reduction in repeat customer escalations',
    body: 'Built the visibility to prove a recurring failure pattern, communicated the RCA, and helped move the problem into cross-functional software remediation.',
    href: '/work/reliability-remediation/',
  },
  {
    eyebrow: 'Operational improvement',
    title: 'A shared operating system for reliability work',
    metric: '60%',
    metricLabel: 'improvement in response and recovery metrics',
    body: 'Improved dashboards and alerts, standardized runbooks and RCA practices, automated workflow coordination, and helped teams adopt a shared response model.',
    href: '/work/operating-model/',
  },
];

const technicalDepth = ['APIs & integrations', 'SQL', 'Authentication', 'AWS', 'Kubernetes', 'Terraform', 'Linux', 'Observability'];
---

<BaseLayout
  title="Mike Gilmore | Technical Delivery & Customer Solutions"
  description="Professional portfolio for Mike Gilmore: technical delivery, implementation, SaaS integrations, systems analysis, customer solutions, cloud, and reliability."
>
  <section class="hero shell section section--hero">
    <div class="hero__content">
      <p class="eyebrow">Technical Delivery & Customer Solutions</p>
      <h1>I turn complex SaaS requirements into clear delivery plans, stable systems, and better customer outcomes.</h1>
      <p class="hero__lede">
        My background spans enterprise implementation, business and systems analysis, integrations, cloud infrastructure,
        and SaaS reliability. I work best where customer needs, technical constraints, and cross-functional delivery meet.
      </p>
      <div class="button-row">
        <a class="button button--primary" href="/work/">View selected work</a>
        <a class="button button--secondary" href="/resume/">View resume</a>
      </div>
    </div>
    <aside class="hero__signal" aria-label="Professional focus">
      <p class="signal-label">Focus</p>
      <ul>
        <li>Implementation & Professional Services</li>
        <li>Business Systems & Program Delivery</li>
        <li>Technical Success & Customer Solutions</li>
      </ul>
      <p class="signal-label">Technical foundation</p>
      <p>APIs · SQL · AWS · Linux · Observability · Automation</p>
    </aside>
  </section>

  <section class="section section--soft" aria-labelledby="proof-heading">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">How I work</p>
        <h2 id="proof-heading">Technical depth is useful when it moves delivery forward.</h2>
      </div>
      <div class="grid grid--3">
        {pillars.map((pillar) => (
          <article class="pillar-card">
            <span class="card-index" aria-hidden="true">0{pillars.indexOf(pillar) + 1}</span>
            <h3>{pillar.title}</h3>
            <p>{pillar.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="shell section" id="work" aria-labelledby="work-heading">
    <div class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 id="work-heading">Three examples of how I move from signal or requirement to a repeatable outcome.</h2>
      </div>
      <a class="text-link" href="/work/">Explore work →</a>
    </div>
    <div class="work-stack">
      {selectedWork.map((item) => (
        <article class="work-card">
          <div class="work-card__copy">
            <p class="eyebrow">{item.eyebrow}</p>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <a class="text-link" href={item.href}>Read case study →</a>
          </div>
          <div class="metric-block">
            <strong>{item.metric}</strong>
            <span>{item.metricLabel}</span>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--dark" aria-labelledby="depth-heading">
    <div class="shell depth-layout">
      <div>
        <p class="eyebrow eyebrow--light">Technical depth</p>
        <h2 id="depth-heading">Engineering depth that helps solve across boundaries.</h2>
        <p class="muted-light">
          Eight years in cloud and reliability engineering let me move from a customer requirement into an API flow, SQL validation,
          cloud environment, production signal, or escalation path when the problem demands it. The engineering work supports the delivery decision rather than becoming a separate conversation.
        </p>
      </div>
      <ul class="skill-cloud" aria-label="Technical skills">
        {technicalDepth.map((skill) => <li>{skill}</li>)}
      </ul>
    </div>
  </section>

  <section class="shell section" aria-labelledby="writing-heading">
    <div class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">Featured writing</p>
        <h2 id="writing-heading">Technical ideas, explained clearly.</h2>
      </div>
      <a class="text-link" href="/blog/">All writing →</a>
    </div>
    <div class="grid grid--3">
      {featuredPosts.map((post) => (
        <article class="article-card">
          <p class="article-card__date">{formatShortDate(post.data.date)}</p>
          <h3><a href={getLegacyBlogPath(post.id)}>{post.data.title}</a></h3>
          <p>{post.data.categories?.slice(0, 3).join(' · ') || 'Technical writing'}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="experience-heading">
    <div class="shell experience-layout">
      <div class="section-heading">
        <p class="eyebrow">Experience</p>
        <h2 id="experience-heading">A career built across customer leadership, technical delivery, and engineering.</h2>
      </div>
      <div class="timeline-summary">
        <div><strong>2022–2026</strong><span>Site Reliability Engineer · Trimble</span></div>
        <div><strong>2018–2022</strong><span>Cloud Engineer · Cityworks</span></div>
        <div><strong>Earlier</strong><span>Technical support, B2B service operations, and multi-unit leadership</span></div>
      </div>
    </div>
  </section>

  <section class="shell section contact-band" aria-labelledby="contact-heading">
    <div>
      <p class="eyebrow">About & contact</p>
      <h2 id="contact-heading">I like work that makes complicated systems easier for people to use, support, and operate.</h2>
      <p>
        Based in the Salt Lake City area. Explore the work, read the technical writing, or connect through LinkedIn and email.
      </p>
    </div>
    <div class="button-row">
      <a class="button button--primary" href="mailto:contactgilmore@gmail.com">Email me</a>
      <a class="button button--secondary" href="https://www.linkedin.com/in/contactgilmore/">LinkedIn</a>
    </div>
  </section>
</BaseLayout>