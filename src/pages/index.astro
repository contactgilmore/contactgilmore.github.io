---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getBlogPath } from '../lib/blog-paths';
import { compareBlogPosts } from '../lib/blog-sort';

const featuredPosts = (await getCollection('blog'))
  .filter(({ data }) => data.draft !== true)
  .sort((a, b) => {
    const featuredDelta = Number(b.data.featured === true) - Number(a.data.featured === true);
    if (featuredDelta !== 0) return featuredDelta;
    return compareBlogPosts(a, b);
  })
  .slice(0, 3);

const formatShortDate = (value: Date) => value.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});

const work = [
  {
    index: '01',
    label: 'Enterprise implementation',
    title: 'From a difficult first migration to repeatable delivery.',
    body: 'Turned lessons from complex customer migrations into scripts, validation checks, runbooks, and repeatable workflows.',
    metric: '100+',
    metricLabel: 'enterprise migrations, implementations, and deployments supported',
    href: '/work/implementation-delivery/',
  },
  {
    index: '02',
    label: 'SaaS reliability',
    title: 'From customer outage complaints to durable remediation.',
    body: 'Built the visibility to prove a recurring failure pattern, communicated the RCA, and helped move the problem into cross-functional software remediation.',
    metric: '55%',
    metricLabel: 'reduction in repeat customer escalations',
    href: '/work/reliability-remediation/',
  },
  {
    index: '03',
    label: 'Operational improvement',
    title: 'A shared operating model for reliability work.',
    body: 'Improved dashboards and alerts, standardized runbooks and RCA practices, automated workflow coordination, and helped teams adopt a shared response model.',
    metric: '60%',
    metricLabel: 'improvement in response and recovery metrics',
    href: '/work/operating-model/',
  },
];

const operatingModel = [
  {
    index: '01',
    title: 'Understand the real requirement.',
    body: 'Start with what the customer, team, or business is trying to accomplish. Separate the requested change from the underlying operating problem before deciding how technical the answer needs to be.',
  },
  {
    index: '02',
    title: 'Move from evidence to action.',
    body: 'Use implementation context, APIs, SQL, cloud signals, observability, and cross-functional discovery when they help establish what is actually happening and what should happen next.',
  },
  {
    index: '03',
    title: 'Leave the result easier to own.',
    body: 'The useful outcome is not only that the change worked. Ownership, validation, documentation, readiness, and the next operating step should be clearer afterward.',
  },
];

const technicalDepth = ['APIs & integrations', 'SQL & data validation', 'Authentication & IAM', 'AWS & cloud', 'Linux', 'Kubernetes', 'Terraform', 'Observability'];
const siteUrl = 'https://contactgilmore.github.io/';
const websiteStructuredData = {
  '@type': 'WebSite',
  '@id': `${siteUrl}#website`,
  name: 'Mike Gilmore',
  alternateName: 'ContactGilmore',
  url: siteUrl,
  inLanguage: 'en-US',
};
---

<BaseLayout
  title="Mike Gilmore | Implementation, Technical Delivery & Customer Solutions"
  description="Mike Gilmore works across implementation, Professional Services, customer-facing technical delivery, integrations, cloud, reliability, and technology-enabled change."
  structuredData={websiteStructuredData}
>
  <section class="home-hero">
    <div class="shell home-hero__inner">
      <p class="eyebrow">Implementation · Professional Services · Technical Success</p>
      <h1>I turn complicated technical change into stable, supportable results.</h1>
      <p class="home-hero__lede">
        My background spans enterprise implementation, customer-facing SaaS delivery, integrations, cloud infrastructure, and reliability.
        I work best where ownership, technical constraints, and cross-functional execution have to line up.
      </p>
      <div class="home-hero__actions">
        <a class="button button--primary" href="/work/">See the work <span aria-hidden="true">→</span></a>
        <a class="text-link" href="/resume/">View resume</a>
      </div>
      <div class="home-hero__rail" aria-label="Professional focus">
        <span>Implementation & delivery</span>
        <span>Customer & stakeholder leadership</span>
        <span>Integrations & troubleshooting</span>
      </div>
    </div>
  </section>

  <section class="home-work section" aria-labelledby="work-heading">
    <div class="shell">
      <div class="home-section-head">
        <p class="eyebrow">Selected work</p>
        <h2 id="work-heading">Work that moved from ambiguity to a result people could use.</h2>
        <p>Three examples of moving from a customer signal, requirement, or operating problem to a result people could use and repeat.</p>
      </div>
      <div class="home-work-list">
        {work.map((item) => (
          <article class="home-work-row">
            <div class="home-work-row__index">{item.index}</div>
            <div class="home-work-row__copy">
              <p class="home-row-label">{item.label}</p>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              <a class="text-link" href={item.href}>Read case study <span aria-hidden="true">↗</span></a>
            </div>
            <div class="home-work-row__metric">
              <strong>{item.metric}</strong>
              <span>{item.metricLabel}</span>
            </div>
          </article>
        ))}
      </div>
      <div class="home-section-action">
        <a class="text-link" href="/work/">Explore all selected work <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="home-method" aria-labelledby="method-heading">
    <div class="shell home-method__grid">
      <div class="home-method__intro">
        <p class="eyebrow eyebrow--light">How I work</p>
        <h2 id="method-heading">Technical depth matters when it helps the work move.</h2>
        <p>
          The job is usually bigger than the tool. I care about whether the requirement is clear, the evidence supports the decision,
          the change is controlled, and the people who inherit the result understand what they own.
        </p>
      </div>
      <div class="home-method__list">
        {operatingModel.map((item) => (
          <div class="home-method-row">
            <span>{item.index}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="home-depth section" aria-labelledby="depth-heading">
    <div class="shell home-depth__grid">
      <div>
        <p class="eyebrow">Technical depth</p>
        <h2 id="depth-heading">Enough engineering depth to work across the boundary.</h2>
      </div>
      <div>
        <p class="home-depth__copy">
          Cloud and reliability engineering gave me deeper context across production behavior, integrations, authentication,
          data, infrastructure, automation, and observability. I use that depth to make delivery decisions better—not to turn every problem into an engineering project.
        </p>
        <ul class="home-depth__rail" aria-label="Technical skills">
          {technicalDepth.map((skill) => <li>{skill}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="home-writing section section--soft" aria-labelledby="writing-heading">
    <div class="shell">
      <div class="home-section-head home-section-head--split">
        <div>
          <p class="eyebrow">Featured writing</p>
          <h2 id="writing-heading">Technical ideas, explained clearly.</h2>
        </div>
        <a class="text-link" href="/blog/">All writing <span aria-hidden="true">→</span></a>
      </div>
      <div class="home-writing-list">
        {featuredPosts.map((post, index) => (
          <article class="home-writing-row">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3><a href={getBlogPath(post.id, post.data.slug)}>{post.data.title}</a></h3>
            <time>{formatShortDate(post.data.date)}</time>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="home-experience section" aria-labelledby="experience-heading">
    <div class="shell home-experience__grid">
      <div>
        <p class="eyebrow">Experience</p>
        <h2 id="experience-heading">A career built across customer leadership, implementation, and engineering.</h2>
      </div>
      <div class="home-experience__timeline">
        <div><strong>2022–2026</strong><span>Site Reliability Engineer · Trimble</span></div>
        <div><strong>2018–2022</strong><span>Cloud Engineer · Cityworks</span></div>
        <div><strong>Earlier</strong><span>Technical support, B2B service operations, and multi-unit leadership</span></div>
      </div>
    </div>
  </section>

  <section class="home-close">
    <div class="shell home-close__grid">
      <div>
        <p class="eyebrow">About & contact</p>
        <h2>Most business problems do not stay in one lane.</h2>
      </div>
      <div>
        <p>
          That is the work I tend to gravitate toward: where a customer issue, implementation problem, technical constraint,
          and operating process all touch the same outcome.
        </p>
        <div class="home-close__actions">
          <a class="text-link" href="/about/">More about how I work <span aria-hidden="true">→</span></a>
          <a class="text-link" href="https://www.linkedin.com/in/contactgilmore/">Connect on LinkedIn <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
