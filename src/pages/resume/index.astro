---
import BaseLayout from '../../layouts/BaseLayout.astro';

const core = ['Enterprise Implementation', 'Professional Services', 'Business Systems Analysis', 'Program Delivery', 'Project Management', 'Customer Onboarding', 'Requirements', 'Stakeholder Management', 'Process Improvement', 'APIs & Integrations', 'SQL', 'Cloud Infrastructure'];
---

<BaseLayout
  title="Resume | Mike Gilmore"
  description="Professional resume summary for Mike Gilmore, focused on implementation, program delivery, systems analysis, SaaS reliability, and customer solutions."
>
  <header class="page-hero shell">
    <p class="eyebrow">Resume</p>
    <h1>Technical delivery, implementation, and systems experience.</h1>
    <p>
      Experience across customer operations, enterprise SaaS implementation, business systems and program delivery, cloud engineering, and site reliability.
    </p>
  </header>

  <section class="shell page-grid">
    <article class="detail-card">
      <p class="eyebrow">Profile</p>
      <h2>Technical Delivery & Customer Solutions</h2>
      <p>
        I work where customer requirements, technical constraints, and cross-functional execution meet. Strengths include discovery, implementation planning, systems analysis, process improvement, integrations, troubleshooting, and stakeholder coordination.
      </p>
      <ul class="tag-list" aria-label="Core capabilities">
        {core.map((skill) => <li>{skill}</li>)}
      </ul>
    </article>

    <article class="detail-card">
      <p class="eyebrow">2022–2026</p>
      <h2>Trimble · Site Reliability Engineer</h2>
      <ul>
        <li>Reduced repeat customer escalations 55% through observability, RCA, and coordinated Product and Engineering remediation.</li>
        <li>Improved response and recovery metrics 60% by strengthening alerting, escalation paths, runbooks, incident documentation, and ownership.</li>
        <li>Cut repeat incidents 40% and improved release reliability 30% through root-cause analysis and readiness practices while protecting 99.9% availability.</li>
        <li>Standardized operating practices across three combined businesses and helped onboard an India-based team into the shared model.</li>
      </ul>
      <div class="button-row">
        <a class="text-link" href="/work/reliability-remediation/">Reliability case study →</a>
        <a class="text-link" href="/work/operating-model/">Operating model case study →</a>
      </div>
    </article>

    <article class="detail-card">
      <p class="eyebrow">2018–2022</p>
      <h2>Cityworks · Cloud Engineer</h2>
      <ul>
        <li>Supported 100+ enterprise migrations, implementations, and deployments through customer discovery, integration context, readiness, and execution planning.</li>
        <li>Turned complex migration lessons into reusable scripts, validation checks, runbooks, and repeatable workflows that accelerated deployments 40% and reduced onboarding effort 50%.</li>
        <li>Reduced onboarding escalations 30% through stronger readiness checks, data validation, licensing/configuration review, and customer handoffs.</li>
        <li>Lowered cloud costs 20% by standardizing customer environments and operating practices while supporting 99.9% uptime and SOC 2 readiness.</li>
      </ul>
      <div class="button-row">
        <a class="text-link" href="/work/implementation-delivery/">Implementation case study →</a>
      </div>
    </article>

    <article class="detail-card">
      <p class="eyebrow">Earlier experience</p>
      <h2>Customer-facing operations and leadership</h2>
      <p>
        Earlier roles include Store Manager at Sears, Senior Advisor in Technical Support Operations at Apple, and Market Manager at Best Buy. That experience built the customer, coaching, operations, and influence-without-authority foundation I later carried into enterprise technical delivery.
      </p>
    </article>
  </section>
</BaseLayout>
